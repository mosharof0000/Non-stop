# Polymarket wallet private key (EOA â€” same as MetaMask)
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here

# CLOB L2 API credentials (from clob.polymarket.com/auth/api-key)
POLYMARKET_L2_KEY=your_l2_api_key
POLYMARKET_L2_SECRET=your_l2_api_secret
POLYMARKET_L2_PASSPHRASE=your_l2_passphrase

# Set to 'false' to place real orders (default: demo mode ON)
DEMO_MODE=true

PORT=3000
